# ──────────────────────────────────────────────────────────────
# 클라이언트 (NEXT_PUBLIC_* 는 번들에 포함됩니다 — 비밀키 절대 금지)
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gs25-expo-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gs25-expo-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=gs25-expo-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise)
NEXT_PUBLIC_APPCHECK_SITE_KEY=
# 개발 전용 디버그 토큰 (Firebase 콘솔에서 발급). prod 에는 절대 넣지 마세요.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# 로컬 에뮬레이터 사용 여부
NEXT_PUBLIC_USE_EMULATOR=false

# Firebase 설정 없이 시드 데이터로 구동 (로컬 데모)
NEXT_PUBLIC_DEMO_MODE=true

# 행사 일정 (ISO8601, KST)
NEXT_PUBLIC_OPEN_AT=2026-10-02T09:00:00+09:00
NEXT_PUBLIC_TOUR_START_AT=2026-10-05T10:00:00+09:00
NEXT_PUBLIC_CLOSE_AT=2026-11-16T23:59:59+09:00

# ──────────────────────────────────────────────────────────────
# 서버 전용 — 운영에서는 반드시 Secret Manager 사용
#   firebase functions:secrets:set SOLAPI_API_KEY   (등등)
# ──────────────────────────────────────────────────────────────
# 휴대폰 번호 암호화/해시 키
PHONE_ENC_KEY=change-me-32-bytes-minimum
PHONE_HMAC_KEY=change-me-hmac-key

# SOLAPI
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=0212345678
# dev 에서 실수 대량 발송을 막는 수신 허용목록 (쉼표 구분)
SMS_ALLOWLIST=01000000000

# ── 본부 로그인 이메일 인증 (Google Apps Script 메일 릴레이) ──
# apps-script/README.md 절차대로 배포한 뒤 두 값을 채웁니다.
# 비우면 로컬 개발 모드로 동작하며 인증번호가 화면에 표시됩니다(메일 미발송).
APPS_SCRIPT_URL=
APPS_SCRIPT_KEY=

# Gemini
GEMINI_API_KEY=

# Google Sheets 백업
SHEETS_SA_JSON=
SHEET_ID=

# Power Automate 연동 공유키
INTEGRATION_KEY=
INTEGRATION_ALLOW_IPS=

# 개발 편의: 로그인 화면에 OTP 표시 (운영에서는 반드시 false)
DEV_SHOW_OTP=true
# 현장 체크인 테스트 시 예약일이 아니어도 허용
CHECKIN_ALLOW_ANY_DAY=false
